{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/webhook-receiver-conformance/v1/plugin-metadata.schema.json",
  "title": "Experimental built-in adapter metadata",
  "x-reproducibility": {
    "volatile_fields": []
  },
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "category",
    "api_version",
    "implementation_version",
    "capabilities",
    "trust"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-experimental"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "category": {
      "enum": [
        "signer",
        "mutation",
        "observer",
        "assertion",
        "reporter",
        "lifecycle"
      ]
    },
    "api_version": {
      "type": "string"
    },
    "implementation_version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "trust": {
      "enum": [
        "built-in-only"
      ]
    },
    "public_compatibility_promise": {
      "const": false
    }
  },
  "additionalProperties": false
}
