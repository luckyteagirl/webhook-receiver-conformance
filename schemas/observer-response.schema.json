{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/webhook-receiver-conformance/v1/observer-response.schema.json",
  "title": "Observer protocol response",
  "type": "object",
  "required": [
    "protocol_version",
    "request_id",
    "status",
    "capabilities",
    "evidence",
    "error"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "status": {
      "enum": [
        "ok",
        "pending",
        "unsupported",
        "error"
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "https://schemas.example.invalid/webhook-receiver-conformance/v1/observer-evidence.schema.json"
      }
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "snapshot_id"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "snapshot_id": {
            "type": "null"
          },
          "evidence": {
            "maxItems": 0
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pending",
              "unsupported"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "snapshot_id": {
            "type": "null"
          },
          "evidence": {
            "maxItems": 0
          },
          "error": {
            "type": "null"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^request_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "maxLength": 34
    },
    "bounded_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "evidence_types",
        "evidence_keys",
        "read_only",
        "idempotent"
      ],
      "properties": {
        "evidence_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.example.invalid/webhook-receiver-conformance/v1/observer-evidence.schema.json#/$defs/evidence_type"
          }
        },
        "evidence_keys": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bounded_key"
          }
        },
        "read_only": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "max_queries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "supports_pending": {
          "type": "boolean"
        },
        "stable_snapshot_ids": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "category",
        "retryable"
      ],
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
