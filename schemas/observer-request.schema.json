{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/webhook-receiver-conformance/v1/observer-request.schema.json",
  "title": "Observer protocol request",
  "type": "object",
  "required": [
    "protocol_version",
    "request_id",
    "operation"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "$ref": "#/$defs/request_id"
    },
    "sample_id": {
      "$ref": "#/$defs/sample_id"
    },
    "operation": {
      "enum": [
        "capabilities",
        "observe"
      ]
    },
    "run_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid_v4"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenario_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/scenario_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/event_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "prior_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "queries": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "key",
          "type"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/bounded_key"
          },
          "type": {
            "$ref": "https://schemas.example.invalid/webhook-receiver-conformance/v1/observer-evidence.schema.json#/$defs/evidence_type"
          },
          "parameters": {
            "$ref": "#/$defs/query_parameters"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "observe"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "sample_id",
          "run_id",
          "queries"
        ],
        "properties": {
          "run_id": {
            "$ref": "#/$defs/uuid_v4"
          },
          "queries": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "sample_id": false,
          "run_id": false,
          "scenario_id": false,
          "event_id": false,
          "checkpoint": false,
          "prior_snapshot_id": false,
          "queries": false
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^request_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "maxLength": 34
    },
    "sample_id": {
      "type": "string",
      "pattern": "^sample_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "maxLength": 33
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^scenario_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "maxLength": 35
    },
    "event_id": {
      "type": "string",
      "pattern": "^event_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "maxLength": 32
    },
    "uuid_v4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "bounded_string": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "bounded_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "json_value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/safe_integer"
        },
        {
          "$ref": "#/$defs/bounded_string"
        },
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "$ref": "#/$defs/bounded_key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json_value"
          }
        }
      ]
    },
    "query_parameters": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/bounded_key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value"
      }
    }
  }
}
