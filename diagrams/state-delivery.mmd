stateDiagram-v2
  [*] --> pending
  pending --> eligible: dependencies and due time satisfied
  pending --> skipped: condition or policy skip
  pending --> cancelled: cancelled
  eligible --> active: physical attempt claimed
  eligible --> skipped: condition or policy skip
  eligible --> cancelled: cancelled
  active --> eligible: retry schedule becomes eligible
  active --> satisfied: qualifying outcome or assertion policy
  active --> exhausted: no eligible attempt remains
  active --> ambiguous: unresolved possible send
  active --> cancelled: cancelled
  satisfied --> [*]
  exhausted --> [*]
  ambiguous --> [*]
  cancelled --> [*]
  skipped --> [*]
